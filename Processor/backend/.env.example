# ==========================================================================
# DocxOCR — Processor backend environment variables
#
# Copy to `.env` for local dev (loaded via python-dotenv). In a real
# deployment these should be injected by the process manager / container
# runtime, not read from a file on disk.
#
# Values marked "*** TODO — bổ sung ***" are placeholders that MUST be
# filled in before the service can run; see DESIGN_REPORT.md §7 "Tham số
# còn thiếu" for the full list and why each one is unresolved.
# ==========================================================================

# ---- Supabase (shared project with User side) ---------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co
PROCESSOR_SUPABASE_URL=*** TODO — bổ sung ***

# service_role key (NOT anon/publishable). Bypasses RLS — keep this out of
# git, out of logs, and never expose it to anything outside this backend.
PROCESSOR_SUPABASE_SERVICE_ROLE_KEY=*** TODO — bổ sung ***

# Storage bucket name. Must match the bucket the User side uploads to
# (User/supabase/storage.sql uses `exam-pages`) — confirm before deploying.
PROCESSOR_SUPABASE_STORAGE_BUCKET=exam-pages

# OPTIONAL — only needed for GET /processor/dashboard's DB/Storage size
# stats (Management API, see services/supabase_management.py). Different
# from the service_role key above: this is a personal access token tied to
# your Supabase *account* (Dashboard -> Account -> Access Tokens), scoped
# across all your projects, not just this one — keep it at least as
# carefully as the service_role key, arguably more so. Leave blank to skip
# these 2 stats (Dashboard shows them as "chưa cấu hình" instead of erroring).
PROCESSOR_SUPABASE_ACCESS_TOKEN=

# ---- llama.cpp OpenAI-compatible server ----------------------------------
# Base URL including the /v1 suffix, e.g. http://localhost:8080/v1
PROCESSOR_LLAMACPP_BASE_URL=*** TODO — bổ sung ***

# llama.cpp's server does not require a real API key by default, but the
# `openai` client always sends an Authorization header — any non-empty
# string works unless the server was started with --api-key.
PROCESSOR_LLAMACPP_API_KEY=not-needed

# Model identifier to send in each request. llama.cpp's OpenAI-compatible
# server usually accepts any string here (it serves whatever was loaded via
# -m/--model), but some setups check it — confirm the expected value with
# whoever launches the llama.cpp server.
PROCESSOR_LLAMACPP_MODEL=*** TODO — bổ sung ***

# ---- Admin API authentication ---------------------------------------------
# Header `X-API-Key` required on all /processor/* routes (list/enqueue/etc).
PROCESSOR_API_KEY=*** TODO — bổ sung (generate a random secret) ***

# Separate, higher-privilege key required (in addition to the one above) for
# POST /processor/admin/reset only.
PROCESSOR_ADMIN_API_KEY=*** TODO — bổ sung (generate a different random secret) ***

# ---- Environment gating ----------------------------------------------------
# One of: dev | staging | production
# /processor/admin/reset is refused unless this is "dev" or "staging".
PROCESSOR_ENV=dev

# ---- Worker tuning (sensible defaults — adjust after load-testing) --------
# Blank = auto-generated as "<hostname>-<pid>". A trailing "# comment" on
# this specific line, tried before, silently becomes part of the value
# instead of being stripped — python-dotenv only recognizes a trailing
# comment when there's a real (non-whitespace) value token before it; on an
# intentionally-empty value it doesn't, so the comment text itself ends up
# as worker_id (confirmed directly against dotenv_values() — this is why
# it's a comment on its own line here instead).
PROCESSOR_WORKER_ID=
PROCESSOR_MAX_CONCURRENT_PAGES=4                 # worker pool size — pages OCR'd concurrently across ALL admitted exams (asyncio, not threads)
PROCESSOR_MAX_CONCURRENT_PROCESSING_PAGES=20     # cap on total PAGES admitted into 'processing' at once, not exams (POST /enqueue refuses past this)
PROCESSOR_WORKER_POLL_INTERVAL_SECONDS=5
PROCESSOR_STALE_CLAIM_TIMEOUT_SECONDS=900  # reclaim exams a crashed worker left claimed
PROCESSOR_HEALTHCHECK_INTERVAL_SECONDS=10
PROCESSOR_OCR_MAX_ATTEMPTS=3
PROCESSOR_OCR_BACKOFF_BASE_SECONDS=2

# Sent as temperature/max_tokens on every model call (see app/prompts.py for
# the prompt itself, which lives in code, not here — see DESIGN_REPORT.md §4.9).
PROCESSOR_OCR_TEMPERATURE=0.0
PROCESSOR_OCR_MAX_TOKENS=4096

# Per-image pixel budget for services/preprocessing.py's smart_resize
# (ported from Qwen2-VL's own preprocessing) — the model's input contract,
# not an image-quality knob. Defaults are Qwen2-VL's own; only change these
# if the model behind llama.cpp differs.
PROCESSOR_MIN_PIXELS=3136
PROCESSOR_MAX_PIXELS=11289600

# ---- Preprocessing (image quality, §2.3 step 2) ---------------------------
PROCESSOR_PREPROCESS_DESKEW=true
PROCESSOR_PREPROCESS_DESKEW_MAX_ANGLE_DEG=15
PROCESSOR_PREPROCESS_ENHANCE_CONTRAST=true
PROCESSOR_PREPROCESS_CONTRAST_CLIP_LIMIT=2.0
PROCESSOR_PREPROCESS_CONTRAST_TILE_GRID_SIZE=8

# ---- Logging ----------------------------------------------------------------
PROCESSOR_LOG_LEVEL=info
PROCESSOR_LOG_DIR=./.logs

# ---- Admin HTTP API ------------------------------------------------------
PROCESSOR_API_HOST=0.0.0.0
PROCESSOR_API_PORT=8800
