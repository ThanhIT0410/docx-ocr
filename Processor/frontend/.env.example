# ==========================================================================
# DocxOCR Processor — Frontend (Nuxt) environment variables
#
# In the packaged/dev Electron app, NONE of these are read: the console
# spawns the admin API + worker itself (electron/sidecar.js) and injects the
# resulting base URL + freshly-generated API keys into the renderer at
# runtime via preload.js (see app/composables/useProcessorApi.ts). This file
# only matters if you run `nuxt dev` in a plain browser tab (no Electron) —
# in that case, run the backend yourself (`python -m app.main`) and point
# these at it.
# ==========================================================================

# Base URL of a manually-run Processor admin API (Processor/backend/app/main.py).
NUXT_PUBLIC_PROCESSOR_API_URL=http://127.0.0.1:8800

# Must match that backend's PROCESSOR_API_KEY exactly — sent as X-API-Key.
NUXT_PUBLIC_PROCESSOR_API_KEY=

# Must match that backend's PROCESSOR_ADMIN_API_KEY exactly — sent as
# X-Admin-API-Key, only on the admin/reset call.
NUXT_PUBLIC_PROCESSOR_ADMIN_API_KEY=
