# ==========================================================================
# DocxOCR — Frontend (Nuxt) environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ==========================================================================

# --- Supabase (required) ---------------------------------------------------
# Project URL, e.g. https://xxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_URL=

# `anon` public key (safe for frontend bundling; access is enforced by RLS).
# NEVER put the `service_role` key here or anywhere in this app.
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Storage bucket name used for exam page images.
NUXT_PUBLIC_SUPABASE_STORAGE_BUCKET=exam-pages

# --- FastAPI sidecar ---------------------------------------------------------
# Base URL of the local FastAPI sidecar. In the packaged Electron app this is
# injected at runtime by the main process (random free port) and this value
# is only used as a fallback for plain `nuxt dev` (browser, no Electron).
NUXT_PUBLIC_SIDECAR_URL=http://127.0.0.1:8756
