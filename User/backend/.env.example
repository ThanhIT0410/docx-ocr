# ==========================================================================
# DocxOCR — Backend (FastAPI sidecar) environment variables
#
# In normal operation NONE of these are read from `.env` — Electron sets
# them directly on the spawned child process's environment every time it
# launches the sidecar (see frontend/electron/sidecar.js). This file only
# matters if you run the sidecar standalone for debugging: `python -m app.main`.
# ==========================================================================

# TCP port to bind on 127.0.0.1. Electron normally picks a free one at
# runtime (see findFreePort in sidecar.js) and sets it as OCR_PORT.
OCR_PORT=8756

# Where preview files (split PDF pages, staged images) are written.
# In the packaged app this is Electron's app.getPath('userData').
OCR_DATA_DIR=./.devdata

# Renderer origin allowed by CORS. Must match exactly (scheme+host+port).
OCR_ALLOWED_ORIGIN=http://localhost:3000

# uvicorn log level: critical|error|warning|info|debug|trace
OCR_LOG_LEVEL=info
